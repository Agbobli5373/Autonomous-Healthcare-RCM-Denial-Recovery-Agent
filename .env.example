# Copy to `.env` and paste in the two keys. `.env` is gitignored; this file is
# not, and must never hold a real key.
#
# Both are needed before the first run rather than discovered at the first
# failure. Plan and remaining credit are visible only in the Solari console —
# there is no account or usage API, so nothing here can read your balance or
# warn you before a run.

# https://getsolari.com — Cloud Browser and Sandbox. The Free tier is enough:
# one sandbox and three browsers, where the demo uses one and two.
SOLARI_API_KEY=

# https://console.anthropic.com — read in this process and never uploaded to the
# sandbox, which is reachable from the public internet while a run lasts.
ANTHROPIC_API_KEY=
